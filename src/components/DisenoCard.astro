---
interface Props {
	nombre: string;
	estilo: string;
	imagen: string;
	href: string;
}

const { nombre, estilo, imagen, href } = Astro.props;
---

<a href={href} class="diseno-card">
	<div class="image">
		<img src={imagen} alt={`Diseño ${nombre}`} loading="lazy" />
	</div>
	<div class="content">
		<h3>{nombre}</h3>
		<span class="estilo">{estilo}</span>
	</div>
	<div class="link">
		<span>Ver demo</span>
		<i class="fas fa-arrow-right"></i>
	</div>
</a>

<style>
	.diseno-card {
		display: flex;
		flex-direction: column;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition: all 0.3s ease;
		cursor: pointer;
		text-decoration: none;
	}

	.diseno-card:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
	}

	.image {
		aspect-ratio: 9/16;
		overflow: hidden;
		background: var(--bg-alt);
	}

	.image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.diseno-card:hover .image img {
		transform: scale(1.05);
	}

	.content {
		padding: 16px;
	}

	.content h3 {
		font-size: 1rem;
		font-weight: 600;
		color: var(--text);
		margin-bottom: 4px;
	}

	.estilo {
		font-size: 0.8rem;
		color: var(--accent);
		font-weight: 500;
	}

	.link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 12px 16px;
		border-top: 1px solid var(--border);
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--text-muted);
		transition: color 0.2s ease;
	}

	.diseno-card:hover .link {
		color: var(--accent);
	}

	.link i {
		transition: transform 0.2s ease;
	}

	.diseno-card:hover .link i {
		transform: translateX(4px);
	}

	@media (prefers-reduced-motion: reduce) {
		.diseno-card,
		.diseno-card:hover,
		.image img,
		.diseno-card:hover .image img,
		.link,
		.diseno-card:hover .link,
		.link i,
		.diseno-card:hover .link i {
			transition: none;
			transform: none;
		}
	}
</style>
