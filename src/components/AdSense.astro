---
interface Props {
	slot: string;
	format?: 'auto' | 'horizontal' | 'vertical' | 'rectangle';
}

const { slot, format = 'auto' } = Astro.props;
---

<div class="ad-container">
	<p class="ad-label">Publicidad</p>
	<ins
		class="adsbygoogle"
		style="display: block"
		data-ad-client="ca-pub-6341354300694706"
		data-ad-slot={slot}
		data-ad-format={format}
		data-full-width-responsive="true"
	></ins>
</div>

<script>
	(window.adsbygoogle = window.adsbygoogle || []).push({});
</script>

<style>
	.ad-container {
		margin: 40px auto;
		text-align: center;
		max-width: 100%;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.02);
		border-radius: 8px;
		padding: 10px;
	}

	.ad-label {
		font-size: 0.7rem;
		color: #64748b;
		margin-bottom: 8px;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	.ad-container :global(ins) {
		min-height: 90px;
	}
</style>
