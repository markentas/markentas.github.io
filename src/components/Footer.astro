---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
	<div class="container">
		<div class="footer-content">
			<p class="footer-logo">mialacan<span>.com</span></p>
			<p class="footer-tagline">
				Explorando la intersección entre tecnología, eventos y productividad
			</p>
			<p class="footer-powered">
				Mialacan es un proyecto desarrollado por <a href="https://markentas.com" target="_blank" rel="noopener noreferrer">Markentas</a>
			</p>
		</div>
		<div class="footer-bottom">
			<p>© {currentYear} mialacan.com - Todos los derechos reservados</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		background: #050505;
		padding: 60px 0 30px;
		border-top: 1px solid var(--border);
	}

	.footer-content {
		text-align: center;
	}

	.footer-logo {
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 8px;
	}

	.footer-logo span {
		color: var(--accent);
	}

	.footer-tagline {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 24px;
	}

	.footer-powered {
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.footer-powered a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 2px;
		transition: opacity 0.2s ease;
	}

	.footer-powered a:hover {
		opacity: 0.8;
	}

	.footer-bottom {
		margin-top: 40px;
		padding-top: 24px;
		border-top: 1px solid var(--border);
		text-align: center;
	}

	.footer-bottom p {
		color: #94a3b8; /* Mejor contraste (WCAG AA) */
		font-size: 0.8rem;
	}</style>
