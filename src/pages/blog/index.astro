---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import AdSense from '../../components/AdSense.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date): string {
	return date.toLocaleDateString('es-ES', {
		day: 'numeric',
		month: 'short',
		year: 'numeric',
	});
}
---

<Layout title="Blog" description="Artículos, guías y noticias sobre invitaciones digitales y más.">
	<Navbar />
	<main>
		<div class="container">
			<header class="page-header">
				<h1>Blog</h1>
				<p>Artículos, guías y noticias sobre invitaciones digitales y más.</p>
			</header>

			<AdSense slot="9537014283" />

			<div class="posts-grid">
				{posts.map((post) => (
					<a href={`/blog/${post.id}/`} class="post-card">
						<div class="post-image">
							{post.data.heroImage ? (
								<img src={post.data.heroImage} alt="" loading="lazy" />
							) : (
								<div class="image-placeholder">
									<i class="fas fa-image"></i>
								</div>
							)}
						</div>
						<div class="post-content">
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
							<div class="post-meta">
								<time datetime={post.data.pubDate.toISOString()}>
									{formatDate(post.data.pubDate)}
								</time>
								{post.data.tags && post.data.tags.length > 0 && (
									<span class="tags">
										{post.data.tags.slice(0, 2).map((tag: string) => (
											<span class="tag">#{tag}</span>
										))}
									</span>
								)}
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	main {
		padding-top: 100px;
		padding-bottom: 80px;
		min-height: 100vh;
	}

	.page-header {
		text-align: center;
		margin-bottom: 48px;
	}

	.page-header h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		margin-bottom: 12px;
		background: linear-gradient(135deg, var(--text) 0%, var(--accent) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.page-header p {
		color: var(--text-muted);
		font-size: 1.1rem;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
	}

	@media (min-width: 640px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.posts-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.post-card {
		display: flex;
		flex-direction: column;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition: all 0.3s ease;
		cursor: pointer;
	}

	.post-card:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
	}

	.post-image {
		aspect-ratio: 16/9;
		overflow: hidden;
		background: var(--bg-alt);
	}

	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.post-card:hover .post-image img {
		transform: scale(1.05);
	}

	.image-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
		font-size: 2rem;
		opacity: 0.3;
	}

	.post-content {
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		flex: 1;
	}

	.post-content h2 {
		font-size: 1.1rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--text);
		transition: color 0.2s ease;
	}

	.post-card:hover .post-content h2 {
		color: var(--accent);
	}

	.post-content p {
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		margin-top: auto;
		padding-top: 12px;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.tags {
		display: flex;
		gap: 6px;
	}

	.tag {
		color: var(--accent);
		opacity: 0.8;
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card,
		.post-card:hover,
		.post-image img,
		.post-card:hover .post-image img,
		.post-content h2,
		.post-card:hover .post-content h2 {
			transition: none;
			transform: none;
		}
	}
</style>
