---
import InvitacionLayout from '../../layouts/InvitacionLayout.astro';

const props = {
  nombre: 'Carlos',
  tipo: '18-anos' as const,
  titulo: 'Mis 18 Años',
  subtitulo: 'Carlos',
  fecha: '15 DE JUNIO DE 2026',
  fechaData: '2026-06-15',
  hora: '22:00',
  lugar: 'CLUB NOCHE',
  direccion: 'Av. Urbana 789, Ciudad',
  padres: ['Miguel Molina', 'Patricia Ruiz'],
  frase: '18 años. Sin límites. Sin barreras. Solo adelante.',
  dresscode: 'FORMAL',
  dresscodeColores: ['black', 'white', 'gold'],
  instagramHashtag: 'MIS18CARLOS',
  invitacionId: 'carlos',
  whatsappMensaje: 'Hola, me contacto desde la tarjeta Carlos, me gustó mucho, quisiera más información',
  imagenes: [
    { src: '/invitaciones/carlos/img/boy1.jpg', alt: 'Carlos', nombre: 'CARLOS MOLINA', subtitle: '18 años' },
    { src: '/invitaciones/carlos/img/boy2.jpg', alt: 'Carlos', nombre: 'CARLOS MOLINA', subtitle: 'Sus momentos' },
    { src: '/invitaciones/carlos/img/boy3.jpg', alt: 'Carlos', nombre: 'CARLOS MOLINA', subtitle: 'Lista para celebrar' },
  ],
  itinerarios: [
    { hora: '22:00 HS', actividad: 'RECEPCIÓN', detalle: 'Ingreso de invitados', icono: '🥂' },
    { hora: '22:30 HS', actividad: 'BRINDIS', detalle: 'Bienvenida oficial', icono: '🥂' },
    { hora: '00:00 HS', actividad: 'CUMPLEAÑOS', detalle: 'El momento clave', icono: '🎊' },
    { hora: '02:00 HS', actividad: 'CIERRE', detalle: 'Fin de la noche', icono: '🌙' },
  ],
  datosBancarios: {
    banco: 'Banco Industrial',
    alias: 'CARLOS.18',
    titular: 'Carlos Molina',
  },
};
---

<InvitacionLayout 
  title={`${props.nombre} - ${props.titulo}`}
  description={`Invitación digital para los 18 años de ${props.nombre}`}
  nombre={props.nombre}
  tipo={props.tipo}
  invitacionId={props.invitacionId}
>
  <div id="notificaciones"></div>

  <audio id="audio" src="/invitaciones/carlos/audio/audio.mp3" loop></audio>

  <button id="btn-musica" class="btn-musica" onclick="toggleMusica()">
    <i class="fas fa-play"></i>
  </button>

  <section id="hero" class="hero">
    <div class="hero-grid"></div>
    <div class="hero-content">
      <div class="hero-box">
        <span class="hero-year">2026</span>
      </div>
      <p class="hero-subtitle">MIS 18 AÑOS</p>
      <h1 class="hero-title">CARLOS</h1>
      <p class="hero-name">MOLINA</p>
      <a href="#fotos" class="hero-btn" onclick="iniciarMusica(); document.getElementById('fotos').scrollIntoView({behavior: 'smooth'}); return false;">ENTRAR</a>
    </div>
  </section>

  <section id="fotos" class="fotos">
    <h2 class="fotos-title">El cumpleañero</h2>
    <div class="slider-container">
      <div class="slider-wrapper" id="sliderWrapper">
        {props.imagenes.map((img, index) => (
          <div class="slider-slide">
            <img src={img.src} alt={img.alt} loading={index === 0 ? 'eager' : 'lazy'} />
            <div class="slider-overlay">
              <p class="slider-name">{img.nombre}</p>
              <p class="slider-subtitle">{img.subtitle}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="slider-nav">
      {props.imagenes.map((_, index) => (
        <div class={`slider-dot ${index === 0 ? 'active' : ''}`} onclick={`goToSlide(${index})`}></div>
      ))}
    </div>
  </section>

  <section id="countdown" class="countdown" data-fecha={props.fechaData} data-hora={props.hora}>
    <div class="countdown-container">
      <div class="countdown-label">LA FIESTA COMIENZA EN</div>
      <div class="countdown-timer">
        <div class="count-block">
          <div class="count-value">
            <span class="count-number" id="days">00</span>
          </div>
          <span class="count-label">Días</span>
        </div>
        <div class="count-block">
          <div class="count-value">
            <span class="count-number" id="hours">00</span>
          </div>
          <span class="count-label">Horas</span>
        </div>
        <div class="count-block">
          <div class="count-value">
            <span class="count-number" id="minutes">00</span>
          </div>
          <span class="count-label">Min</span>
        </div>
        <div class="count-block">
          <div class="count-value">
            <span class="count-number" id="seconds">00</span>
          </div>
          <span class="count-label">Seg</span>
        </div>
      </div>
    </div>
  </section>

  <section id="padres" class="padres">
    <div class="padres-container">
      <div class="padres-line"></div>
      <p class="padres-text">CON LA BENDICIÓN DE</p>
      <p class="padres-names">{props.padres[0]} <span>&</span> {props.padres[1]}</p>
      <div class="padres-line"></div>
    </div>
  </section>

  <section id="fecha" class="fecha">
    <div class="fecha-content">
      <div class="fecha-day">15</div>
      <div class="fecha-info">
        <span class="fecha-mes">JUNIO</span>
        <span class="fecha-año">2026</span>
      </div>
      <div class="fecha-hour">22:00 HS</div>
    </div>
  </section>

  <section id="frase" class="frase">
    <div class="frase-container">
      <p class="frase-text">{props.frase}</p>
      <p class="frase-autor">— CARLOS</p>
    </div>
  </section>

  <section id="ubicacion" class="ubicacion">
    <div class="ubicacion-container">
      <div class="ubicacion-marker">
        <i class="fas fa-map-marker-alt"></i>
      </div>
      <p class="ubicacion-titulo">UBICACIÓN</p>
      <p class="ubicacion-lugar">{props.lugar}</p>
      <p class="ubicacion-detalle">{props.direccion}</p>
      <a href="#" onclick="mostrarDemo(); return false;" class="ubicacion-btn">VER MAPA</a>
    </div>
  </section>

  <section id="dresscode" class="dresscode">
    <div class="dresscode-container">
      <p class="dresscode-titulo">DRESS CODE</p>
      <p class="dresscode-texto">{props.dresscode}</p>
      <div class="dresscode-colors">
        {props.dresscodeColores.map(color => (
          <div class={`color-box`}>
            <div class={`color-swatch ${color}`}></div>
            <span>{color.toUpperCase()}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="itinerario" class="itinerario">
    <div class="itinerario-container">
      <p class="itinerario-titulo">AGENDA</p>
      <div class="itinerario-list">
        {props.itinerarios.map(item => (
          <div class="itinerario-item">
            <div class="itinerario-time">{item.hora.replace(' HS', '')}</div>
            <div class="itinerario-dot"></div>
            <div class="itinerario-details">
              <p class="itinerario-actividad">{item.actividad}</p>
              <p class="itinerario-detalle">{item.detalle}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="regalos" class="regalos">
    <div class="regalos-container">
      <p class="regalos-titulo">REGALOS</p>
      <p class="regalos-texto">Tu presencia es lo que importa. Si deseas colaborar, usa la cuenta que te compartire al confirmar.</p>
      <button class="regalos-btn" onclick="openModal()">VER DATOS</button>
    </div>
  </section>

  <section id="instagram" class="instagram">
    <div class="instagram-container">
      <p class="instagram-titulo">#{props.instagramHashtag}</p>
      <p class="instagram-texto">Etiqueta tus fotos para que pueda ver todo lo que pasó.</p>
      <p class="instagram-usuario">@carlos_molina</p>
    </div>
  </section>

  <section id="confirmar" class="confirmar">
    <div class="confirmar-container" id="confirmarNormal">
      <p class="confirmar-titulo">CONFIRMA</p>
      <p class="confirmar-fecha">HASTA EL 1 DE JUNIO</p>
      <a href="#" onclick="mostrarDemo(); return false;" class="confirmar-btn">WHATSAPP</a>
    </div>
    <div class="confirmar-container" id="confirmarToken" style="display: none">
      <div class="confirmar-icon">🎉</div>
      <h2 class="confirmar-titulo">Confirmar Asistencia</h2>
      <p class="confirmar-texto" id="confirmarNombre">Hola, te invito a mi fiesta</p>
      <div class="confirmar-form" id="confirmarForm">
        <p class="confirmar-cantidad">¿Cuántas personas vienen?</p>
        <div class="confirmar-numeros">
          <button type="button" onclick="cambiarCantidad(-1)">-</button>
          <span id="cantidadPersonas">1</span>
          <button type="button" onclick="cambiarCantidad(1)">+</button>
        </div>
        <p class="confirmar-info" id="confirmarInfo">Somos 1 persona</p>
        <div class="confirmar-botones">
          <button type="button" class="confirmar-btn si" onclick="confirmarAsistencia('si')">
            <i class="fas fa-check"></i> Asistiré
          </button>
          <button type="button" class="confirmar-btn no" onclick="confirmarAsistencia('no')">
            <i class="fas fa-times"></i> No podré asistir
          </button>
        </div>
      </div>
      <div class="confirmar-exito" id="confirmarExito" style="display: none">
        <i class="fas fa-check-circle"></i>
        <p>¡Gracias por confirmar!</p>
      </div>
    </div>
  </section>

  <section id="footer" class="footer">
    <div class="footer-container">
      <div class="footer-icon">⚡</div>
      <p class="footer-texto">TE INVITO</p>
      <p class="footer-nombre">CARLOS</p>
      <p class="footer-fecha">15.06.2026</p>
      <div class="footer-markentas">
        <a href="/invitaciones#18-anos" class="footer-markentas-link">← Volver a los Diseños</a>
      </div>
      <div class="footer-panel">
        <a href="/invitaciones/carlos/admin/index.html" class="footer-panel-link">PANEL</a>
      </div>
    </div>
  </section>

  <a 
    href={`https://api.markentas.com/api/whatsapp?src=${encodeURIComponent(props.whatsappMensaje)}`}
    target="_blank"
    class="whatsapp-float"
    id="whatsappBtn"
  >
    <i class="fab fa-whatsapp"></i>
  </a>

  <button class="saludos-float" id="saludosBtn" onclick="abrirModalSaludos()">
    <i class="fas fa-comments"></i>
    <span class="saludos-badge" id="saludosBadge">0</span>
  </button>

  <div id="modalSaludos" class="modal" onclick="closeModalSaludos(event)">
    <div class="modal-content saludos-modal">
      <button class="modal-cerrar" onclick="closeModalSaludos()">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L13 13M1 13L13 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <h3 class="modal-titulo">Libro de Visitas</h3>
      <div class="saludos-lista" id="saludosLista">
        <p class="saludos-vacio">Cargando...</p>
      </div>
      <div class="saludos-form">
        <input type="text" id="saludoNombre" placeholder="Tu nombre" class="saludos-input" />
        <textarea id="saludoMensaje" placeholder="Escribe tu mensaje..." class="saludos-textarea" rows="2"></textarea>
        <button class="saludos-btn" onclick="enviarSaludo()">Enviar</button>
      </div>
    </div>
  </div>

  <div id="modal" class="modal" onclick="closeModal(event)">
    <div class="modal-content">
      <button class="modal-cerrar" onclick="closeModal()">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L13 13M1 13L13 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <p class="modal-titulo">DATOS DE PAGO</p>
      <div class="modal-datos">
        <p class="modal-banco">{props.datosBancarios.banco}</p>
        <p class="modal-alias">{props.datosBancarios.alias}</p>
        <p class="modal-titular">Titular: {props.datosBancarios.titular}</p>
      </div>
      <button class="modal-cerrar-btn" onclick="closeModal()">CERRAR</button>
    </div>
  </div>

  <div id="lightbox" class="lightbox">
    <button class="lightbox-cerrar" onclick="cerrarLightbox()">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L13 13M1 13L13 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <button class="lightbox-nav lightbox-prev" onclick="navegarLightbox(-1)">&#10094;</button>
    <button class="lightbox-nav lightbox-next" onclick="navegarLightbox(1)">&#10095;</button>
    <img id="lightbox-img" class="lightbox-img" src="" alt="Foto" />
  </div>


  <script>
    window.addEventListener('scroll', function () {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight;
      const winHeight = window.innerHeight;
      const whatsappBtn = document.getElementById('whatsappBtn');

      if (whatsappBtn) {
        if (scrollTop + winHeight >= docHeight - 200) {
          whatsappBtn.classList.add('visible');
        } else {
          whatsappBtn.classList.remove('visible');
        }
      }
    });
  </script>
</InvitacionLayout>
