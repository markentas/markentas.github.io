---
import InvitacionLayout from '../../layouts/InvitacionLayout.astro';

interface BodaProps {
  nombre: string;
  tipo: 'boda';
  titulo: string;
  fecha: string;
  fechaData: string;
  hora: string;
  lugarCeremonia: string;
  direccionCeremonia: string;
  lugarRecepcion: string;
  direccionRecepcion: string;
  padres1: string[];
  padres2: string[];
  frase: string;
  dresscode: string;
  instagramHashtag: string;
  invitacionId: string;
  whatsappMensaje: string;
  itinerarios: { hora: string; actividad: string; detalle?: string }[];
  datosBancarios: { banco: string; alias: string; titular: string };
}

const props: BodaProps = {
  nombre: 'Isabella y Santiago',
  tipo: 'boda',
  titulo: 'Boda Signature',
  fecha: '12 DE OCTUBRE DE 2026',
  fechaData: '2026-10-12',
  hora: '17:30',
  lugarCeremonia: 'Catedral Metropolitana',
  direccionCeremonia: 'Plaza Mayor 123, Centro Histórico',
  lugarRecepcion: 'Club Premium Events',
  direccionRecepcion: 'Ruta 9 Km 45, Pilar',
  padres1: ['María Elena López', 'Roberto García'],
  padres2: ['Carmen Beatriz', 'Andrés Felipe'],
  frase: '"Amar es encontrar en la felicidad de otro tu propia felicidad."',
  dresscode: 'Black Tie',
  instagramHashtag: 'IsabellaYSantiago2026',
  invitacionId: 'boda-signature',
  whatsappMensaje: 'Hola, me contacto desde la tarjeta Boda Signature, me gustó mucho, quisiera más información',
  itinerarios: [
    { hora: '17:30', actividad: 'Ceremonia Religiosa', detalle: 'Catedral Metropolitana' },
    { hora: '18:45', actividad: 'Traslado a Recepción', detalle: 'Servicio de transporte' },
    { hora: '19:00', actividad: 'Recepción & Cocktail', detalle: 'Jardines Club Premium' },
    { hora: '20:00', actividad: 'Cena Gala', detalle: 'Salón Principal' },
    { hora: '22:00', actividad: 'Primer Baile', detalle: 'Pista de Baile' },
    { hora: '23:30', actividad: 'Fiesta & Torta', detalle: 'Salón de Baile' },
  ],
  datosBancarios: {
    banco: 'BBVA Francés',
    alias: 'ISABELLA.SANTIAGO',
    titular: 'Isabella López',
  },
};
---

<InvitacionLayout 
  title={`${props.nombre} - ${props.titulo}`}
  description={`Invitación digital para la boda de ${props.nombre}`}
  nombre={props.nombre}
  tipo={props.tipo}
  invitacionId={props.invitacionId}
>
  <div id="notificaciones"></div>

  <audio id="audio" src="/invitaciones/boda-signature/audio/audio.mp3" loop></audio>

  <button id="btn-musica" class="btn-musica" onclick="toggleMusica()">
    <i class="fas fa-compact-disc"></i>
  </button>

  <section id="hero" class="hero">
    <div class="hero-ornament">
      <svg viewBox="0 0 100 20" class="ornament-line"><path d="M0,10 Q50,0 100,10" stroke="#d4af7d" fill="none" stroke-width="0.5"/></svg>
    </div>
    <div class="hero-content">
      <p class="hero-preheader">Save the Date</p>
      <h1 class="hero-names">Isabella<br><span class="hero-amp">&</span><br>Santiago</h1>
      <p class="hero-date">{props.fecha}</p>
      <a href="#intro" class="hero-btn" onclick="iniciarMusica(); document.getElementById('intro').scrollIntoView({behavior: 'smooth'}); return false;">Descubrir</a>
    </div>
    <div class="hero-ornament hero-ornament-bottom">
      <svg viewBox="0 0 100 20" class="ornament-line"><path d="M0,10 Q50,20 100,10" stroke="#d4af7d" fill="none" stroke-width="0.5"/></svg>
    </div>
  </section>

  <section id="intro" class="intro">
    <div class="intro-crown">✦</div>
    <p class="intro-parents">Con la alegría de nuestros padres</p>
    <p class="intro-names">{props.padres1[0]} <span>&</span> {props.padres1[1]}</p>
    <p class="intro-names">{props.padres2[0]} <span>&</span> {props.padres2[1]}</p>
  </section>

  <section id="countdown" class="countdown" data-fecha={props.fechaData} data-hora={props.hora}>
    <h2 class="countdown-title">La Cuenta Regresiva</h2>
    <div class="countdown-grid">
      <div class="count-unit">
        <span class="count-number" id="days">00</span>
        <span class="count-label">Días</span>
      </div>
      <div class="count-unit">
        <span class="count-number" id="hours">00</span>
        <span class="count-label">Horas</span>
      </div>
      <div class="count-unit">
        <span class="count-number" id="minutes">00</span>
        <span class="count-label">Minutos</span>
      </div>
      <div class="count-unit">
        <span class="count-number" id="seconds">00</span>
        <span class="count-label">Segundos</span>
      </div>
    </div>
  </section>

  <section id="frase" class="frase">
    <div class="frase-quote">"</div>
    <p class="frase-text">{props.frase}</p>
    <p class="frase-autor">— Isabella & Santiago</p>
  </section>

  <section id="ceremonia" class="ceremonia">
    <div class="ceremonia-badge">CEREMONIA</div>
    <div class="ceremonia-content">
      <div class="ceremonia-icon"><i class="fas fa-church"></i></div>
      <h3 class="ceremonia-lugar">{props.lugarCeremonia}</h3>
      <p class="ceremonia-direccion">{props.direccionCeremonia}</p>
      <p class="ceremonia-hora">{props.hora} HS</p>
      <a href="#" onclick="mostrarDemo(); return false;" class="ceremonia-mapa">Ver Ubicación</a>
    </div>
  </section>

  <section id="recepcion" class="recepcion">
    <div class="recepcion-badge">RECEPCIÓN</div>
    <div class="recepcion-content">
      <div class="recepcion-icon"><i class="fas fa-hotel"></i></div>
      <h3 class="recepcion-lugar">{props.lugarRecepcion}</h3>
      <p class="recepcion-direccion">{props.direccionRecepcion}</p>
      <p class="recepcion-hora">19:00 HS - Cocktail</p>
      <p class="recepcion-hora">20:00 HS - Cena</p>
      <a href="#" onclick="mostrarDemo(); return false;" class="recepcion-mapa">Ver Ubicación</a>
    </div>
  </section>

  <section id="dresscode" class="dresscode">
    <div class="dresscode-header">
      <div class="dresscode-icon">✦</div>
      <h2 class="dresscode-title">Dress Code</h2>
    </div>
    <p class="dresscode-formal">{props.dresscode}</p>
    <p class="dresscode-nota">Se solicita no usar blanco ni rojo</p>
    <div class="dresscode-palette">
      <div class="palette-swatch" style="background: #1a1a1a;" title="Negro"></div>
      <div class="palette-swatch" style="background: #722f37;" title="Borgoña"></div>
      <div class="palette-swatch" style="background: #0f1e3d;" title="Azul Noche"></div>
      <div class="palette-swatch" style="background: #d4af7d;" title="Dorado"></div>
    </div>
  </section>

  <section id="itinerario" class="itinerario">
    <h2 class="itinerario-title">Programa del Día</h2>
    <div class="itinerario-list">
      {props.itinerarios.map(item => (
        <div class="itinerario-item">
          <div class="itinerario-content">
            <div class="itinerario-row">
              <span class="itinerario-time">{item.hora}</span>
              <div class="itinerario-detail">
                <strong>{item.actividad}</strong>
                <span>{item.detalle}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="galeria" class="galeria">
    <div class="galeria-container">
      <div class="galeria-icon">✦</div>
      <h2 class="galeria-titulo">Galería de Invitados</h2>
      <p class="galeria-texto">Comparte tus fotos de la boda conmigo</p>
      <div class="galeria-grid" id="galeriaGrid"></div>
      <div class="galeria-upload">
        <input type="file" id="galeriaInput" accept="image/*" multiple hidden />
        <button class="galeria-btn" onclick="document.getElementById('galeriaInput').click()">
          <i class="fas fa-cloud-upload-alt"></i> Subir mis fotos
        </button>
        <div class="galeria-preview" id="galeriaPreview" style="display: none">
          <div class="galeria-preview-grid" id="galeriaPreviewGrid"></div>
          <div class="galeria-preview-buttons">
            <button class="galeria-submit" id="btnEnviar" onclick="subirFotos()">Enviar todas</button>
            <button class="galeria-cancel" onclick="cancelarFotos()">Cancelar</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="regalos" class="regalos">
    <div class="regalos-header">
      <div class="regalos-icon">✦</div>
      <h2 class="regalos-title">Mesa de Regalos</h2>
    </div>
    <p class="regalos-text">Tu presencia es el mejor regalo. Si deseas colaborar con nuestra nueva vida, hemoms preparado estas opciones:</p>
    <div class="regalos-options">
      <button class="regalos-btn" onclick="openModal()">
        <i class="fas fa-university"></i> Datos Bancarios
      </button>
    </div>
  </section>

  <section id="hashtag" class="hashtag">
    <div class="hashtag-content">
      <p class="hashtag-label">Comparte与我们</p>
      <p class="hashtag-tag">#{props.instagramHashtag}</p>
      <p class="hashtag-social">@bellaysantiago.boda</p>
    </div>
  </section>

  <section id="rsvp" class="rsvp">
    <div class="rsvp-header">
      <div class="rsvp-icon">✦</div>
      <div id="rsvpNormal">
        <h2 class="rsvp-title">Confirmar Asistencia</h2>
        <p class="rsvp-text">Por favor, confirma tu asistencia antes del <strong>15 de Septiembre de 2026</strong></p>
        <p class="rsvp-include">Incluí cantidad de acompañantes y restricciones alimentarias</p>
        <a href="#" onclick="mostrarDemo(); return false;" class="rsvp-btn">
          <i class="fab fa-whatsapp"></i> Confirmar por WhatsApp
        </a>
      </div>
      <div id="rsvpToken" style="display: none">
        <h2 class="rsvp-title">Confirmar Asistencia</h2>
        <p class="rsvp-texto" id="rsvpNombre">¡Hola! Te esperamos en nuestra boda</p>
        <div class="rsvp-form" id="rsvpForm">
          <p class="rsvp-cantidad">¿Cuántas personas vienen?</p>
          <div class="rsvp-numeros">
            <button type="button" onclick="cambiarCantidad(-1)">-</button>
            <span id="cantidadPersonas">1</span>
            <button type="button" onclick="cambiarCantidad(1)">+</button>
          </div>
          <p class="rsvp-info" id="rsvpInfo">Somos 1 persona</p>
          <div class="rsvp-botones">
            <button type="button" class="rsvp-btn si" onclick="confirmarAsistencia('si')">
              <i class="fas fa-check"></i> Asistiré
            </button>
            <button type="button" class="rsvp-btn no" onclick="confirmarAsistencia('no')">
              <i class="fas fa-times"></i> No podré asistir
            </button>
          </div>
        </div>
        <div class="rsvp-exito" id="rsvpExito" style="display: none">
          <i class="fas fa-check-circle"></i>
          <p>¡Gracias por confirmar!</p>
        </div>
      </div>
    </div>
  </section>

  <section id="footer" class="footer">
    <div class="footer-ornament">✦</div>
    <p class="footer-text">Con la bendición de Dios</p>
    <p class="footer-names">Isabella <span class="footer-amp">&</span> Santiago</p>
    <p class="footer-date">12 . 10 . 2026</p>
    <p class="footer-message">Los esperamos para celebrar este amor</p>
    <div class="footer-markentas">
      <a href="/invitaciones#bodas" class="footer-markentas-link">← Volver a los Diseños</a>
    </div>
    <div class="footer-panel">
      <a href="/invitaciones/boda-signature/admin/index.html" class="footer-panel-link">PANEL</a>
    </div>
  </section>

  <a 
    href={`https://api.markentas.com/api/whatsapp?src=${encodeURIComponent(props.whatsappMensaje)}`}
    target="_blank"
    class="whatsapp-float"
    id="whatsappBtn"
  >
    <i class="fab fa-whatsapp"></i>
  </a>

  <button class="saludos-float" id="saludosBtn" onclick="abrirModalSaludos()">
    <i class="fas fa-comments"></i>
    <span class="saludos-badge" id="saludosBadge">0</span>
  </button>

  <div id="modalSaludos" class="modal" onclick="closeModalSaludos(event)">
    <div class="modal-content saludos-modal">
      <button class="modal-cerrar" onclick="closeModalSaludos()">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L13 13M1 13L13 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <h3 class="modal-titulo">Libro de Visitas</h3>
      <div class="saludos-lista" id="saludosLista">
        <p class="saludos-vacio">Cargando...</p>
      </div>
      <div class="saludos-form">
        <input type="text" id="saludoNombre" placeholder="Tu nombre" class="saludos-input" />
        <textarea id="saludoMensaje" placeholder="Escribe tu mensaje..." class="saludos-textarea" rows="2"></textarea>
        <button class="saludos-btn" onclick="enviarSaludo()">Enviar</button>
      </div>
    </div>
  </div>

  <div id="lightbox" class="lightbox">
    <button class="lightbox-cerrar" onclick="cerrarLightbox()">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L13 13M1 13L13 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <button class="lightbox-nav lightbox-prev" onclick="navegarLightbox(-1)">&#10094;</button>
    <button class="lightbox-nav lightbox-next" onclick="navegarLightbox(1)">&#10095;</button>
    <img id="lightbox-img" class="lightbox-img" src="" alt="Foto" />
  </div>

  <div id="modal" class="modal" onclick="closeModal(event)">
    <div class="modal-content">
      <div class="modal-header">✦</div>
      <h3 class="modal-title">Datos para Transferencia</h3>
      <div class="modal-body">
        <div class="modal-row">
          <span class="modal-label">Banco</span>
          <span class="modal-value">{props.datosBancarios.banco}</span>
        </div>
        <div class="modal-row">
          <span class="modal-label">Alias</span>
          <span class="modal-value">{props.datosBancarios.alias}</span>
        </div>
        <div class="modal-row">
          <span class="modal-label">Titular</span>
          <span class="modal-value">{props.datosBancarios.titular}</span>
        </div>
      </div>
      <button class="modal-btn" onclick="closeModal()">Cerrar</button>
    </div>
  </div>


  <script>
    window.addEventListener('scroll', function () {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight;
      const winHeight = window.innerHeight;
      const whatsappBtn = document.getElementById('whatsappBtn');

      if (whatsappBtn) {
        if (scrollTop + winHeight >= docHeight - 200) {
          whatsappBtn.classList.add('visible');
        } else {
          whatsappBtn.classList.remove('visible');
        }
      }
    });

    const galeriaInput = document.getElementById('galeriaInput') as HTMLInputElement | null;
    if (galeriaInput) {
      galeriaInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.files) seleccionarFotos(target.files);
      });
    }

    if (document.getElementById('galeriaGrid')) cargarGaleria();
    if (document.getElementById('saludosBtn')) verificarToken();
  </script>
</InvitacionLayout>
