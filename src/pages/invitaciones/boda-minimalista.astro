---
import InvitacionLayout from '../../layouts/InvitacionLayout.astro';

interface BodaProps {
  nombre: string;
  tipo: 'boda';
  titulo: string;
  fecha: string;
  fechaData: string;
  hora: string;
  lugarCeremonia: string;
  direccionCeremonia: string;
  lugarRecepcion: string;
  direccionRecepcion: string;
  padres1: string[];
  padres2: string[];
  frase: string;
  dresscode: string;
  instagramHashtag: string;
  invitacionId: string;
  whatsappMensaje: string;
  itinerarios: { hora: string; actividad: string }[];
  datosBancarios: { banco: string; alias: string; titular: string };
}

const props: BodaProps = {
  nombre: 'Valentina y Alejandro',
  tipo: 'boda',
  titulo: 'Boda Minimalista',
  fecha: '15 DE AGOSTO DE 2026',
  fechaData: '2026-08-15',
  hora: '18:00',
  lugarCeremonia: 'Iglesia San Miguel',
  direccionCeremonia: 'Av. Corrientes 1500, Centro',
  lugarRecepcion: 'The Grand Palace',
  direccionRecepcion: 'Av. Libertador 2500, Palermo',
  padres1: ['Roberto Rojas', 'Carolina Pérez'],
  padres2: ['Alberto Muñoz', 'Sandra Herrera'],
  frase: '"Two souls, one heart."',
  dresscode: 'FORMAL',
  instagramHashtag: 'VALEANDALE',
  invitacionId: 'boda-minimalista',
  whatsappMensaje: 'Hola, me contacto desde la tarjeta Boda Minimalista, me gustó mucho, quisiera más información',
  itinerarios: [
    { hora: '18:00', actividad: 'Ceremonia' },
    { hora: '19:30', actividad: 'Cocktail' },
    { hora: '20:30', actividad: 'Cena' },
    { hora: '22:00', actividad: 'Primer Baile' },
    { hora: '23:00', actividad: 'Fiesta' },
  ],
  datosBancarios: {
    banco: 'Galicia',
    alias: 'VALE.ALE.BODA',
    titular: 'Valentina Rojas',
  },
};
---

<InvitacionLayout 
  title={`${props.nombre} - ${props.titulo}`}
  description={`Invitación digital para la boda de ${props.nombre}`}
  nombre={props.nombre}
  tipo={props.tipo}
  invitacionId={props.invitacionId}
>
  <div id="notificaciones"></div>

  <audio id="audio" src="/invitaciones/boda-minimalista/audio/audio.mp3" loop></audio>

  <button id="btn-musica" class="btn-musica" onclick="toggleMusica()">
    <i class="fas fa-volume-up"></i>
  </button>

  <section id="hero" class="hero">
    <div class="hero-content">
      <p class="hero-date">15 . 08 . 2026</p>
      <h1 class="hero-names">Valentina<br>& Alejandro</h1>
      <a href="#intro" class="hero-btn" onclick="iniciarMusica(); document.getElementById('intro').scrollIntoView({behavior: 'smooth'}); return false;">Invitación</a>
    </div>
  </section>

  <section id="intro" class="intro">
    <p class="intro-text">NOS CASAMOS</p>
    <p class="intro-parents">Con la bendición de</p>
    <p class="intro-fathers">{props.padres1[0]} & {props.padres1[1]}</p>
    <p class="intro-fathers">{props.padres2[0]} & {props.padres2[1]}</p>
  </section>

  <section id="countdown" class="countdown" data-fecha={props.fechaData} data-hora={props.hora}>
    <div class="countdown-item">
      <span class="countdown-num" id="days">00</span>
      <span class="countdown-label">días</span>
    </div>
    <div class="countdown-sep">:</div>
    <div class="countdown-item">
      <span class="countdown-num" id="hours">00</span>
      <span class="countdown-label">horas</span>
    </div>
    <div class="countdown-sep">:</div>
    <div class="countdown-item">
      <span class="countdown-num" id="minutes">00</span>
      <span class="countdown-label">min</span>
    </div>
    <div class="countdown-sep">:</div>
    <div class="countdown-item">
      <span class="countdown-num" id="seconds">00</span>
      <span class="countdown-label">seg</span>
    </div>
  </section>

  <section id="details" class="details">
    <div class="details-content">
      <div class="detail-item">
        <span class="detail-label">Fecha</span>
        <span class="detail-value">15 de Agosto 2026</span>
      </div>
      <div class="detail-item">
        <span class="detail-label">Hora</span>
        <span class="detail-value">18:00 hs</span>
      </div>
    </div>
  </section>

  <section id="ceremony" class="ceremony">
    <p class="ceremony-type">CEREMONIA</p>
    <h2 class="ceremony-venue">{props.lugarCeremonia}</h2>
    <p class="ceremony-address">{props.direccionCeremonia}</p>
    <p class="ceremony-time">18:00 HS</p>
    <a href="#" onclick="mostrarDemo(); return false;" class="ceremony-map">MAPA</a>
  </section>

  <section id="recepcion" class="recepcion">
    <p class="recepcion-type">RECEPCIÓN</p>
    <h2 class="recepcion-venue">{props.lugarRecepcion}</h2>
    <p class="recepcion-address">{props.direccionRecepcion}</p>
    <p class="recepcion-time">19:30 HS - Cocktail</p>
    <p class="recepcion-time">20:30 HS - Cena</p>
    <a href="#" onclick="mostrarDemo(); return false;" class="recepcion-map">MAPA</a>
  </section>

  <section id="itinerario" class="itinerario">
    <div class="itinerario-ornament">
      <svg viewBox="0 0 80 12" fill="none">
        <path d="M0 6 H35 M45 6 H80" stroke="#C9A56A" stroke-width="0.5"/>
        <path d="M40 2 L42 6 L40 10 L38 6 Z" fill="#C9A56A"/>
      </svg>
    </div>
    <p class="itinerario-title">PROGRAMA</p>
    <div class="itinerario-list">
      {props.itinerarios.map(item => (
        <div class="itinerario-item">
          <div class="itinerario-content">
            <div class="itinerario-row">
              <span class="itinerario-time">{item.hora}</span>
              <span class="itinerario-text">{item.actividad}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="info" class="info">
    <div class="info-item">
      <i class="fas fa-car"></i>
      <span class="info-label">Estacionamiento</span>
      <span class="info-text">Valet disponible</span>
    </div>
    <div class="info-item">
      <i class="fas fa-bus"></i>
      <span class="info-label">Transporte</span>
      <span class="info-text">Shuttle desde hotel</span>
    </div>
    <div class="info-item">
      <i class="fas fa-bed"></i>
      <span class="info-label">Hospedaje</span>
      <span class="info-text">Hotel partner: 20% dto</span>
    </div>
  </section>

  <section id="dresscode" class="dresscode">
    <p class="dresscode-label">DRESS CODE</p>
    <p class="dresscode-value">{props.dresscode}</p>
    <p class="dresscode-note">No usar blanco</p>
  </section>

  <section id="frase" class="frase">
    <p class="frase-text">{props.frase}</p>
  </section>

  <section id="registry" class="registry">
    <p class="registry-label">MESA DE REGALOS</p>
    <div class="registry-buttons">
      <button class="registry-btn" onclick="openModal()">TRANSFERENCIA</button>
    </div>
  </section>

  <section id="galeria" class="instagram">
    <div class="instagram-container">
      <p class="instagram-label">GALERÍA DE INVITADOS</p>
      <p class="instagram-text">Comparte tu foto de la boda conmigo</p>
      <div class="galeria-grid" id="galeriaGrid"></div>
      <div class="galeria-upload">
        <input type="file" id="galeriaInput" accept="image/*" multiple hidden />
        <button class="galeria-btn" onclick="document.getElementById('galeriaInput').click()">
          <i class="fas fa-camera"></i>
          Subir mis fotos
        </button>
        <div class="galeria-preview" id="galeriaPreview" style="display: none">
          <div class="galeria-preview-grid" id="galeriaPreviewGrid"></div>
          <div class="galeria-preview-buttons">
            <button class="galeria-submit" id="btnEnviar" onclick="subirFotos()">Enviar todas</button>
            <button class="galeria-cancel" onclick="cancelarFotos()">Cancelar</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="instagram" class="instagram">
    <p class="instagram-label">#{props.instagramHashtag}</p>
    <p class="instagram-user">@vale.ale.boda</p>
  </section>

  <section id="rsvp" class="rsvp">
    <div id="rsvpNormal">
      <p class="rsvp-label">CONFIRMAR ASISTENCIA</p>
      <p class="rsvp-date">Antes del 15 de Julio</p>
      <p class="rsvp-note">Incluir nombre y cantidad de invitados</p>
      <a href="#" onclick="mostrarDemo(); return false;" class="rsvp-btn">WHATSAPP</a>
    </div>
    <div id="rsvpToken" style="display: none">
      <p class="rsvp-label">Confirmar Asistencia</p>
      <p class="rsvp-texto" id="rsvpNombre">Hola, te invito a nuestra boda</p>
      <div class="rsvp-form" id="rsvpForm">
        <p class="rsvp-cantidad">¿Cuántas personas vienen?</p>
        <div class="rsvp-numeros">
          <button type="button" onclick="cambiarCantidad(-1)">-</button>
          <span id="cantidadPersonas">1</span>
          <button type="button" onclick="cambiarCantidad(1)">+</button>
        </div>
        <p class="rsvp-info" id="rsvpInfo">Somos 1 persona</p>
        <div class="rsvp-botones">
          <button type="button" class="rsvp-btn si" onclick="confirmarAsistencia('si')">
            <i class="fas fa-check"></i> Asistiré
          </button>
          <button type="button" class="rsvp-btn no" onclick="confirmarAsistencia('no')">
            <i class="fas fa-times"></i> No podré asistir
          </button>
        </div>
      </div>
      <div class="rsvp-exito" id="rsvpExito" style="display: none">
        <i class="fas fa-check-circle"></i>
        <p>¡Gracias por confirmar!</p>
      </div>
    </div>
  </section>

  <section id="footer" class="footer">
    <p class="footer-names">V & A</p>
    <p class="footer-date">15 . 08 . 2026</p>
    <div class="footer-markentas">
      <a href="/invitaciones#bodas" class="footer-markentas-link">← Volver a los Diseños</a>
    </div>
    <div class="footer-panel">
      <a href="/invitaciones/boda-minimalista/admin/index.html" class="footer-panel-link">PANEL</a>
    </div>
  </section>

  <a 
    href={`https://api.markentas.com/api/whatsapp?src=${encodeURIComponent(props.whatsappMensaje)}`}
    target="_blank"
    class="whatsapp-float"
    id="whatsappBtn"
  >
    <i class="fab fa-whatsapp"></i>
  </a>

  <button class="saludos-float" id="saludosBtn" onclick="abrirModalSaludos()">
    <i class="fas fa-comments"></i>
    <span class="saludos-badge" id="saludosBadge">0</span>
  </button>

  <div id="modalSaludos" class="modal" onclick="closeModalSaludos(event)">
    <div class="modal-content saludos-modal">
      <button class="modal-cerrar" onclick="closeModalSaludos()">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L13 13M1 13L13 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <h3 class="modal-titulo">Libro de Visitas</h3>
      <div class="saludos-lista" id="saludosLista">
        <p class="saludos-vacio">Cargando...</p>
      </div>
      <div class="saludos-form">
        <input type="text" id="saludoNombre" placeholder="Tu nombre" class="saludos-input" />
        <textarea id="saludoMensaje" placeholder="Escribe tu mensaje..." class="saludos-textarea" rows="2"></textarea>
        <button class="saludos-btn" onclick="enviarSaludo()">Enviar</button>
      </div>
    </div>
  </div>

  <div id="modal" class="modal" onclick="closeModal(event)">
    <div class="modal-content">
      <button class="modal-cerrar" onclick="closeModal()">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L13 13M1 13L13 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <p class="modal-title">DATOS DE TRANSFERENCIA</p>
      <div class="modal-row">
        <span>Banco</span>
        <span>{props.datosBancarios.banco}</span>
      </div>
      <div class="modal-row">
        <span>Alias</span>
        <span>{props.datosBancarios.alias}</span>
      </div>
      <div class="modal-row">
        <span>Titular</span>
        <span>{props.datosBancarios.titular}</span>
      </div>
      <button class="modal-btn" onclick="closeModal()">CERRAR</button>
    </div>
  </div>

  <div id="lightbox" class="lightbox">
    <button class="lightbox-cerrar" onclick="cerrarLightbox()">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L13 13M1 13L13 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <button class="lightbox-nav lightbox-prev" onclick="navegarLightbox(-1)">&#10094;</button>
    <button class="lightbox-nav lightbox-next" onclick="navegarLightbox(1)">&#10095;</button>
    <img id="lightbox-img" class="lightbox-img" src="" alt="Foto" />
  </div>


  <script>
    window.addEventListener('scroll', function () {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight;
      const winHeight = window.innerHeight;
      const whatsappBtn = document.getElementById('whatsappBtn');

      if (whatsappBtn) {
        if (scrollTop + winHeight >= docHeight - 200) {
          whatsappBtn.classList.add('visible');
        } else {
          whatsappBtn.classList.remove('visible');
        }
      }
    });
  </script>
</InvitacionLayout>
